# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API). The anon key is safe in the browser;
# row-level security is the boundary. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Folder of markdown files Crisp reads as your local workspace.
# Defaults to ./workspace.
# CRISP_WORKSPACE=/absolute/path/to/your/workspace
